# =============================================================================
# Smart Leads Dashboard — Environment & API Reference
# =============================================================================
#
# SETUP (local)
# ------------
# 1. Copy this file:
#      cp .env.example server/.env
#      cp .env.example client/.env
#    Or copy only the relevant sections into server/.env and client/.env.
# 2. Install dependencies:
#      cd server && npm install
#      cd ../client && npm install
# 3. Start MongoDB locally (or use MongoDB Atlas — see README).
# 4. Run the API:  cd server && npm run dev
# 5. Run the UI:   cd client && npm run dev
# 6. Open http://localhost:5173
#
# DEPLOYMENT LINKS (update after you deploy)
# ------------------------------------------
# Frontend (Vercel):  https://YOUR-APP.vercel.app
# API (Render):       https://YOUR-API.onrender.com
# Health check:       https://YOUR-API.onrender.com/api/health
# MongoDB (Atlas):    https://cloud.mongodb.com
#
# =============================================================================
# SERVER VARIABLES (server/.env)
# =============================================================================

PORT=5001
MONGODB_URI=mongodb://localhost:27017/smart-leads
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Production examples:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/smart-leads?retryWrites=true&w=majority
# CLIENT_URL=https://YOUR-APP.vercel.app
# JWT_SECRET=generate-a-long-random-string-for-production

# =============================================================================
# CLIENT VARIABLES (client/.env)
# =============================================================================

VITE_API_URL=http://localhost:5001/api

# Production example:
# VITE_API_URL=https://YOUR-API.onrender.com/api

# =============================================================================
# API DOCUMENTATION
# Base URL: {VITE_API_URL}  (default local: http://localhost:5001/api)
# Auth: Bearer <token> on protected routes (header: Authorization: Bearer <token>)
# Response shape: { success, message, data?, meta?, errors? }
# =============================================================================
#
# --- Health ---
# GET /health
#   Public. No auth.
#   Response: { success: true, message: "Smart Leads API is running" }
#
# --- Auth (/auth) ---
# POST /auth/register
#   Public. Body: { name, email, password, role? }
#   role: "admin" | "sales" (optional, default: sales)
#   Response 201: { data: { token, user: { id, name, email, role } } }
#
# POST /auth/login
#   Public. Body: { email, password }
#   Response: { data: { token, user: { id, name, email, role } } }
#
# GET /auth/me
#   Protected. Response: { data: { id, name, email, role } }
#
# --- Leads (/leads) — all routes require authentication ---
# GET /leads
#   Query: page?, status?, source?, search?, sort?
#   status: New | Contacted | Qualified | Lost
#   source: Website | Instagram | Referral
#   sort: latest | oldest (default: latest)
#   Response: { data: Lead[], meta: { page, limit, total, totalPages, hasNextPage, hasPrevPage } }
#
# GET /leads/export
#   Same query filters as GET /leads (except page). Returns CSV file download.
#
# GET /leads/:id
#   Response: { data: Lead }
#
# POST /leads
#   Body: { name, email, source, status? }
#   status optional (default: New)
#   Response 201: { data: Lead }
#
# PUT /leads/:id
#   Body: { name?, email?, status?, source? } (partial update)
#   Response: { data: Lead }
#
# DELETE /leads/:id
#   Admin only. Response: { success: true, message: "Lead deleted successfully" }
#
# --- Lead object ---
# { _id, name, email, status, source, createdBy, createdAt, updatedAt }
#
# --- Error codes ---
# 400 Validation error (errors[] with field + message)
# 401 Missing/invalid token
# 403 Forbidden (e.g. sales user deleting a lead)
# 404 Not found
# 409 Email already registered
# 500 Server error
#
# =============================================================================
